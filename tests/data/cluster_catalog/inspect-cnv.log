#!/bin/bash
export BASE_COLLECTION_PATH="${BASE_COLLECTION_PATH:-/must-gather}"
function main() {
  declare mandatory_scripts=(
    "apiservices"
    "cdi"
    "crds"
    "hco"
    "nodes"
  )
  parse_flags "$@"
  run_scripts
}
function parse_flags {
  while :; do
    case $1 in
      --images) requested_scripts+=("images") ;;
      --vms_details) requested_scripts+=("vms_details") ;;
      *) break ;;
    esac
    shift
  done
}

